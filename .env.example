# Copy this file to .env and fill in your real key. .env is gitignored.
OPENAI_API_KEY=sk-your-key-here

# Model used by all three agents (Generator / Critic / Coordinator). Moved
# from gpt-4o-mini after real Critic reasoning instability on that tier.
OPENAI_MODEL=gpt-4o

# Local persistent Chroma directory (created on first run of scripts/build_index.py)
CHROMA_PERSIST_DIR=.chroma

# Embedding model for retrieval (sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Number of top chunks to retrieve per query. Raised from 4 after switching
# to sentence-level chunking, which needs a higher top_k (more, smaller chunks).
RETRIEVAL_TOP_K=12

# Coordinator loop control
MAX_REVISION_CYCLES=1

# MLflow tracking (local SQLite file by default; the file:./mlruns backend is deprecated)
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=adversarial-verification
