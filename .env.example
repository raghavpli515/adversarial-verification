# Copy this file to .env and fill in your real key. .env is gitignored.
OPENAI_API_KEY=sk-your-key-here
# Model used by all three agents (Generator / Critic / Coordinator).
# See src/verification/config.py for how this is consumed.
OPENAI_MODEL=gpt-4o
# Switched from gpt-4o-mini: the Critic showed real reasoning instability on
# the mini tier (self-contradictory findings, factually-incorrect "implies
# but doesn't state directly" claims on text that says "because" outright) -
# two rounds of prompt fixes reduced but didn't eliminate it. gpt-4o costs
# ~15-17x more per token but a full 50-prompt eval still runs well under $1.

# Local persistent Chroma directory (created on first run of scripts/build_index.py)
# (Chroma vector database)Chroma directory refers to the local vector store where embeddings are stored for retrieval .
CHROMA_PERSIST_DIR=.chroma

# Embedding model for retrieval (sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Retrieval
RETRIEVAL_TOP_K=12  # Number of top chunks to retrieve per query, by embedding similarity.
# Raised from 4: several corpus documents share near-identical sentence
# templates (e.g. "The Lunar Module, nicknamed 'X,' landed in...") across
# different missions, which can crowd out the correct chunk at low k. Chunking
# was also switched to sentence-level (see corpus_loader.py), which produced
# more, smaller chunks (46 -> 153) and pushed the target chunk in the worst
# observed case from rank 29/46 to rank 12/153 - top_k=12 is set to capture it.

# Coordinator loop control
MAX_REVISION_CYCLES=1

# MLflow tracking (local SQLite file by default — no server needed. The plain
# filesystem backend, file:./mlruns, is in maintenance mode as of current MLflow.)
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=adversarial-verification
